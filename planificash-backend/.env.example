# Environment: local | development | production
NODE_ENV=local

# PostgreSQL - Supabase (o local para desarrollo)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=planificash
DB_SSL=false

# Supabase API (obtener de: supabase.com → proyecto → Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Server
PORT=3000
